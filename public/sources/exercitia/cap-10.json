{"id": "cap-10", "number": 10, "roman": "X", "title": "Beasts and Men", "latinTitle": "CAPITVLVM DECIMVM", "blocks": [{"t": "li", "n": 7, "text": "Domine ______ singulāris est."}, {"t": "li", "n": 8, "text": "Dominī ______ singulāris est aut ______ plūrālis."}, {"t": "li", "n": 9, "text": "Dominīs et verbīs ______ aut ______ plūrālis est."}, {"t": "li", "n": 10, "text": "Dominō et verbō ______ aut ______ singulāris est."}, {"t": "li", "n": 11, "text": "Dominōrum et verbōrum ______ ______ est."}, {"t": "li", "n": 12, "text": "Dominōs ______ ______ est."}, {"t": "li", "n": 13, "text": "______ ______ ______ est."}, {"t": "li", "n": 14, "text": "Dominus ______ ______ est."}, {"t": "li", "n": 15, "text": "Verba ______ aut ______ plūrālis est."}, {"t": "li", "n": 16, "text": "Verbī ______ singulāris est."}, {"t": "li", "n": 17, "text": "Verbum ______ aut ______ ______ est."}, {"t": "h", "text": "Exercitium 11"}, {"t": "p", "text": "Dēclīnātiō tertia Exempla: pāstor, gen. sing. -ōris, m. ovis, gen. sing. -is, f. Sing. Plūr. Sing. Plūr."}, {"t": "li", "n": 1, "text": "Nōm. pāstor pāstōr____ ov____ ov____"}, {"t": "li", "n": 2, "text": "Acc. pāstōr____ pāstōr____ ov____ ov____"}, {"t": "li", "n": 3, "text": "Gen. pāstōr____ pāstōr____ ov____ ov____"}, {"t": "li", "n": 4, "text": "Dat. pāstōr____ pāstōr____ ov____ ov____"}, {"t": "li", "n": 5, "text": "Abl. pāstōr____ pāstōr____ ov____ ov____"}, {"t": "li", "n": 6, "text": "Pāstor ______ singulāris est."}, {"t": "li", "n": 7, "text": "Pāstōre et ove ______ ______ est."}, {"t": "li", "n": 8, "text": "Pāstōrem et ovem ______ ______ est."}, {"t": "li", "n": 9, "text": "Pāstōrēs et ovēs ______ aut ______ plūrālis est."}, {"t": "li", "n": 10, "text": "Pāstōrī et ovī ______ ______ est."}, {"t": "li", "n": 11, "text": "Pāstōribus et ovibus ______ aut ______ plūrālis est."}, {"t": "li", "n": 12, "text": "Pāstōris ______ ______ est."}, {"t": "li", "n": 13, "text": "Ovis ______ aut ______ singulāris est."}, {"t": "li", "n": 14, "text": "Pāstōrum et ovium ______ ______ est."}, {"t": "h", "text": "Lēctiō prīma (versūs 1–34)"}, {"t": "h", "text": "Exercitium 1"}, {"t": "li", "n": 1, "text": "Lupus et canis et ovis ______ sunt."}, {"t": "li", "n": 2, "text": "Virī et fēminae ______ sunt."}, {"t": "li", "n": 3, "text": "Lupus est bēstia ______; etiam ______ bestia fera est."}, {"t": "li", "n": 4, "text": "In Āfricā sunt multī leōnēs et aliae ______ [= bēstiae ferae]."}, {"t": "li", "n": 5, "text": "______ sunt bēstiae quae in aquā ______."}, {"t": "li", "n": 6, "text": "______ sunt bēstiae quae in āere ______."}, {"t": "li", "n": 7, "text": "______ est magna avis fera quae parvās avēs ______ et est."}, {"t": "li", "n": 8, "text": "Avis quae volat ālās ______; piscis quī natat ______ movet."}, {"t": "li", "n": 9, "text": "Homō quī ambulat ______ movet."}, {"t": "li", "n": 10, "text": "______ homō ambulat, pedēs moventur."}, {"t": "li", "n": 11, "text": "Cum avis in ______ volat, ______ moventur."}, {"t": "li", "n": 12, "text": "Avis ālās habet, itaque avis volāre ______."}, {"t": "li", "n": 13, "text": "Leō volāre nōn potest, ______ [= quia] ālās nōn habet."}, {"t": "li", "n": 14, "text": "Hominēs, quī pedēs habent, ambulāre ______."}, {"t": "li", "n": 15, "text": "Quī ambulat vestīgia in terrā ______."}, {"t": "li", "n": 16, "text": "Nōn sōlum equus, sed etiam ______ hominem vehere potest."}, {"t": "li", "n": 17, "text": "Mercurius est ______ mercātōrum et ______ deōrum."}, {"t": "li", "n": 18, "text": "______ est homō qui emit et vēndit."}, {"t": "h", "text": "Exercitium 2"}, {"t": "li", "n": 1, "text": "Quid est leō? ..."}, {"t": "li", "n": 2, "text": "Quid bēstiae ferae edunt? ..."}, {"t": "li", "n": 3, "text": "Cūr leōnēs ab hominibus timentur? ..."}, {"t": "li", "n": 4, "text": "Quae bēstiae in aquā natant? ..."}, {"t": "li", "n": 5, "text": "Quae bēstiae volant? ..."}, {"t": "li", "n": 6, "text": "Quid movētur cum avis volat? ..."}, {"t": "li", "n": 7, "text": "Quot pedēs habet homō? ..."}, {"t": "li", "n": 8, "text": "Equus quot pedēs habet? ..."}, {"t": "li", "n": 9, "text": "Cūr equus volāre nōn potest? ..."}, {"t": "li", "n": 10, "text": "Cūr piscēs ambulāre nōn possunt? ..."}, {"t": "li", "n": 11, "text": "Hominēsne natāre possunt? ..."}, {"t": "li", "n": 12, "text": "Quis est Mercurius? ..."}, {"t": "li", "n": 13, "text": "In pedibus et in petasō Mercuriī quid est? ..."}, {"t": "li", "n": 14, "text": "Quōrum deus est Mercurius? ..."}, {"t": "li", "n": 15, "text": "Quid est mercātor? ..."}, {"t": "h", "text": "Exercitium 3"}, {"t": "li", "n": 1, "text": "In Āfricā sunt multī leō______ ."}, {"t": "li", "n": 2, "text": "In Āfricā magnus numerus leō______ est."}, {"t": "li", "n": 3, "text": "Multī hom______ Rōmae habitant."}, {"t": "li", "n": 4, "text": "Rōmae habitat magnus numerus hom______ ."}, {"t": "li", "n": 5, "text": "Leō nōn est amīcus hom______ , neque homō amīcus leō______ est."}, {"t": "li", "n": 6, "text": "Homō leō______ timet, et hom______ timet leō."}, {"t": "li", "n": 7, "text": "Leō ab hom______ timētur, et hom______ timētur ā leō______ ."}, {"t": "li", "n": 8, "text": "Leō______ timentur ab hom______ , et hom______ ā leō______ timentur."}, {"t": "h", "text": "Lēctiō secunda (versūs 35-73)"}, {"t": "h", "text": "Exercitium 4"}, {"t": "li", "n": 1, "text": "Avēs vol______ possunt; piscēs nat______ possunt."}, {"t": "li", "n": 2, "text": "Equus ambul______ et curr______ potest."}, {"t": "li", "n": 3, "text": "Ovēs lupum aud______ possunt, neque eum vid______ possunt."}, {"t": "li", "n": 4, "text": "Iūlia centum numer______ nōn potest."}, {"t": "li", "n": 5, "text": "Homō mortuus sē mov______ nōn potest."}, {"t": "li", "n": 6, "text": "Sub aquā homō nōn potest spīr______ ."}, {"t": "li", "n": 7, "text": "Sine animā nēmō potest vīv______ ."}, {"t": "li", "n": 8, "text": "Animam dūc______ necesse est hominī."}, {"t": "li", "n": 9, "text": "Necesse nōn est gemmās hab______ ."}, {"t": "li", "n": 10, "text": "Quī gemmās vēndit pecūniam fac______ potest."}, {"t": "h", "text": "Exercitium 5"}, {"t": "p", "text": "Exempla: Iūlius Iūliam portāre/vehere potest. Iūlia ā Iūliō portārī/vehī potest."}, {"t": "li", "n": 1, "text": "Iūlia magnum saccum port______ nōn potest."}, {"t": "li", "n": 2, "text": "Magnus saccus ā parvā puellā port______ nōn potest."}, {"t": "li", "n": 3, "text": "Hominēs deōs neque vid______ neque aud______ possunt."}, {"t": "li", "n": 4, "text": "Deī neque vid______ neque aud______ possunt ab hominibus."}, {"t": "li", "n": 5, "text": "Nēmō piscēs numer______ potest: piscēs numer______ nōn possunt."}, {"t": "li", "n": 6, "text": "Quī pecūniam habet cibum em______ potest."}, {"t": "li", "n": 7, "text": "Sine pecūniā cibus em______ nōn potest."}, {"t": "li", "n": 8, "text": "Mārcus et Quīntus nōn possunt lectīcam veh______ ."}, {"t": "li", "n": 9, "text": "Ā parvīs puerīs lectīca veh______ nōn potest."}, {"t": "li", "n": 10, "text": "Canis ōstium neque aper______ neque claud______ potest."}, {"t": "li", "n": 11, "text": "Ōstium ā cane neque aper______ neque claud______ potest."}, {"t": "h", "text": "Exercitium 6"}, {"t": "li", "n": 1, "text": "Magnum ______ est Nīlus."}, {"t": "li", "n": 2, "text": "Ōceanus Atlanticus magnum ______ est."}, {"t": "li", "n": 3, "text": "Piscēs nōn in terrā, sed in aquā ______ ."}, {"t": "li", "n": 4, "text": "Cum homō ______ , anima in ______ intrat et rūrsus exit."}, {"t": "li", "n": 5, "text": "______ est āēr quī in pulmōnēs dūcitur."}, {"t": "li", "n": 6, "text": "Quī spirat ______ est, quī nōn spirat est ______ ."}, {"t": "li", "n": 7, "text": "Sine animā et cibō ______ vīvere potest."}, {"t": "li", "n": 8, "text": "Spirāre et esse hominibus ______ est."}, {"t": "li", "n": 9, "text": "Hominēs et bēstiae ______ sunt."}, {"t": "li", "n": 10, "text": "Avēs in arboribus ______ faciunt."}, {"t": "li", "n": 11, "text": "Nīdī sunt inter ______ et ______ arborum."}, {"t": "li", "n": 12, "text": "In nīdīs sunt ______ aut pullī."}, {"t": "li", "n": 13, "text": "Avēs ōva ______ , ex quibus ______ exeunt."}, {"t": "li", "n": 14, "text": "Ovis nōn ōva, sed pullōs vīvōs ______ ."}, {"t": "li", "n": 15, "text": "Fēminae quae pecūniam facere ______ ōrnāmenta sua vēndunt."}, {"t": "h", "text": "Exercitium 7"}, {"t": "li", "n": 1, "text": "Nīlus magn______ flūm______ est."}, {"t": "li", "n": 2, "text": "Nīlus et Rhēnus magn______ flūm______ sunt."}, {"t": "li", "n": 3, "text": "Mārcus et Quīntus in parvō flūm______ natant."}, {"t": "li", "n": 4, "text": "Puerī in aquā flūm______ natant."}, {"t": "li", "n": 5, "text": "Parva flūm______ magnō flūm______ aquam dant."}, {"t": "li", "n": 6, "text": "Ōceanus magn______ mar______ est."}, {"t": "li", "n": 7, "text": "Inter Eurōpam et Āfricam mult______ mar______ sunt."}, {"t": "li", "n": 8, "text": "In Ōceanō et in cēterīs mar______ multī sunt piscēs."}, {"t": "li", "n": 9, "text": "In flūm______ quoque magnus numerus piscium est."}, {"t": "li", "n": 10, "text": "Nēmō piscēs mar______ et flūm______ numerāre potest."}, {"t": "li", "n": 11, "text": "Piscēs sunt animāl______ quae vīvunt in mar______ ."}, {"t": "li", "n": 12, "text": "Leō est animal qu______ in terrā vīvit."}, {"t": "li", "n": 13, "text": "Magnus numerus animāl______ in terrā vīvunt."}, {"t": "li", "n": 14, "text": "Parv______ animāl______ ā magnīs animāl______ eduntur."}, {"t": "h", "text": "Lēctiō tertia (versūs 74–131)"}, {"t": "h", "text": "Exercitium 8"}, {"t": "li", "n": 1, "text": "Iūlia cum puerīs lūdere ______ , neque iī cum puellā ______ volunt."}, {"t": "li", "n": 2, "text": "Puerī Iūliam ______ [= cantāre] audiunt."}, {"t": "li", "n": 3, "text": "Iūlia ______ pulchram habet: ______ Iūliae pulchra est."}, {"t": "li", "n": 4, "text": "Avēs ______ sunt neque canunt; puerī ______ [= nam puerī] nīdōs quaerunt."}, {"t": "li", "n": 5, "text": "Avēs perterritae inter folia arborum sē ______ ."}, {"t": "li", "n": 6, "text": "Quīntus in arborem ______ ; Mārcus eum aspicit neque ipse in arborem ascendere ______ ."}, {"t": "li", "n": 7, "text": "Nōn ______ , sed tenuis est rāmus quō nīdus ______ ."}, {"t": "li", "n": 8, "text": "Rāmus ______ puerum crassum sustinēre nōn potest."}, {"t": "li", "n": 9, "text": "Quīntus ad terram ______ ."}, {"t": "li", "n": 10, "text": "Puer spīrat; ______ vīvit, nam quī spīrat mortuus ______ nōn potest."}, {"t": "li", "n": 11, "text": "Pater fīlium in vīllam portat et in ______ pōnit."}, {"t": "h", "text": "Exercitium 9"}, {"t": "p", "text": "Exempla: Albīnus clāmat. Lydia Albīnum clāmāre audit. Saccus ā Syrō aperītur. Puer saccum ā Syrō aperīrī videt. Saccus plēnus est. Puer saccum plēnum esse videt."}, {"t": "li", "n": 1, "text": "Iūlia canit. Puerī Iūli______ can______ audiunt."}, {"t": "li", "n": 2, "text": "Iūlia ā Mārcō pulsātur. Quīntus Iūli______ ā Mārcō puls______ videt."}, {"t": "li", "n": 3, "text": "Iūlia plōrat et Mārcus rīdet. Quīntus Iūli______ plōr______ et Mārc______ rīd______ audit."}, {"t": "li", "n": 4, "text": "Aemilia venit. Puerī Aemili______ ven______ vident."}, {"t": "li", "n": 5, "text": "Aemilia īrāta est. Mārcus Aemili______ īrāt______ es______ videt."}, {"t": "li", "n": 6, "text": "Pullī mortuī sunt. Iūlia pull______ mortu______ es______ videt."}, {"t": "li", "n": 7, "text": "Dāvus ā Iūliō interrogātur et ā Mēdō accūsātur. Aemilia Dāv______ ā Iūliō interrog______ et ā Mēdō accūs______ audit."}, {"t": "li", "n": 8, "text": "Mēdus ā Iūliō vocātur neque venit. Aemilia Mēd______ ā Iūliō voc______ audit neque e______ ven______ videt."}, {"t": "h", "text": "Exercitium 10"}, {"t": "li", "n": 1, "text": "Quid puerī in hortō agunt? ..."}, {"t": "li", "n": 2, "text": "Quid agit Iūlia? ..."}, {"t": "li", "n": 3, "text": "Cūr avēs hortī nōn canunt? ..."}, {"t": "li", "n": 4, "text": "Cūr Mārcus Quīntum vocat? ..."}, {"t": "li", "n": 5, "text": "Mārcusne in arborem ascendit? ..."}, {"t": "li", "n": 6, "text": "Quid est in nīdō ad quem Quīntus ascendit? ..."}, {"t": "li", "n": 7, "text": "Cūr rāmus tenuis Quīntum sustinēre nōn potest? ..."}, {"t": "li", "n": 8, "text": "Quid Mārcus perterritus videt? ..."}, {"t": "li", "n": 9, "text": "Estne mortuus Quīntus? ..."}, {"t": "li", "n": 10, "text": "Pullīne mortuī sunt? ..."}, {"t": "li", "n": 11, "text": "Quid facit Mārcus? ..."}, {"t": "li", "n": 12, "text": "Quō pater currit et quid videt? ..."}, {"t": "li", "n": 13, "text": "Quō fūlius fīlium suum portat? ..."}, {"t": "li", "n": 14, "text": "Quid videt Aemilia? ..."}, {"t": "h", "text": "Lēctiō grammatica (versūs 132–183)"}, {"t": "h", "text": "Exercitium 11"}, {"t": "li", "n": 1, "text": "Vocā imperātīvus est. Vocāre est ______ ."}, {"t": "li", "n": 2, "text": "Vidē|re, pōn|ere, audī|re nōn imperātīvus, sed ______ est."}, {"t": "li", "n": 3, "text": "Imperātīvus: intrā. Īnfīnītīvus: intr______ ."}, {"t": "li", "n": 4, "text": "Imperātīvus: tacē. Īnfīnītīvus: tac______ ."}, {"t": "li", "n": 5, "text": "Imperātīvus: discēde. Īnfīnītīvus: discēd______ ."}, {"t": "li", "n": 6, "text": "Imperātīvus: venī. Īnfīnītīvus: ven______ ."}, {"t": "li", "n": 7, "text": "Vocā|re est īnfīnītīvus āctīvī. Vocā|rī ______ passīvī est."}, {"t": "li", "n": 8, "text": "Vidē|rī, pōn|ī, audī|rī nōn īnfīnītīvus āctīvī, sed ______ ______ est."}, {"t": "li", "n": 9, "text": "Īnfīnītīvus: āctīvum voc______ , passīvum voc______ ."}, {"t": "li", "n": 10, "text": "Īnfīnītīvus: āctīvum vid______ , passīvum vid______ ."}, {"t": "li", "n": 11, "text": "Īnfīnītīvus: āctīvum pōn______ , passīvum pōn______ ."}, {"t": "li", "n": 12, "text": "Īnfīnītīvus: āctīvum aud______ , passīvum aud______ ."}], "margin": ["dēclīnātiō II", "(gen. sing. -ī)", "neutr.", "sing. plūr", "nōm. -um -a", "acc. -um -a", "gen. -ī -ōrum", "dat. -ō -īs", "abl. -ō -īs", "dēclīnātiō III", "(gen. sing. -is)", "masc./fēm.", "sing. plūr.", "nōm. - -ēs", "acc. -em -ēs", "gen. -is -um", "dat. -ī -ibus", "abl. -e -ibus", "nōm. -is -ēs", "gen. -is -ium", "Lēctiō I", "āēr", "āla", "aquila", "asinus", "avis", "bēstia", "capit", "cauda", "cum", "deus", "facit", "fera", "ferus", "h