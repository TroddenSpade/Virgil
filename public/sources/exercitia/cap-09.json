{"id": "cap-09", "number": 9, "roman": "IX", "title": "The Shepherd and the Sheep", "latinTitle": "CAPITVLVM NONVM", "blocks": [{"t": "h", "text": "Lēctiō prīma (versūs 1–38)"}, {"t": "h", "text": "Exercitium 1"}, {"t": "li", "n": 1, "text": "Ecce pāstor cum can______ et centum ov______ ."}, {"t": "li", "n": 2, "text": "Pāstor ūnum can______ et centum ov______ habet."}, {"t": "li", "n": 3, "text": "Pāstor est dominus can______ et ov______ ."}, {"t": "li", "n": 4, "text": "Pāstor can______ et ov______ cibum dat."}, {"t": "li", "n": 5, "text": "Can______ et ov______ ā pāstōr______ cibum accipiunt."}, {"t": "li", "n": 6, "text": "Dominus huius pāstōr______ est Iūlius."}, {"t": "li", "n": 7, "text": "Iūlius pāstōr______ suō pānem dat."}, {"t": "li", "n": 8, "text": "Iūlius nōn ūnum pāstōr______, sed multōs pāstōr______ habet."}, {"t": "li", "n": 9, "text": "Iūlius est dominus multōrum pāstōr______ ."}, {"t": "li", "n": 10, "text": "Iūlius pāstōr______ suīs pānem dat."}, {"t": "li", "n": 11, "text": "Pāstōr______ pānem accipiunt ā dominō suō."}, {"t": "li", "n": 12, "text": "Ovēs ā pāstōr______ suīs nōn abeunt."}, {"t": "h", "text": "Exercitium 2"}, {"t": "li", "n": 1, "text": "P"}, {"t": "h", "text": "Exercitium 4"}, {"t": "li", "n": 1, "text": "Pāstor bon____ ab ovibus nōn abit."}, {"t": "li", "n": 2, "text": "Ovēs pāstōrem bon____ amant."}, {"t": "li", "n": 3, "text": "Iūlius est dominus pāstōris bon____ ."}, {"t": "li", "n": 4, "text": "Iūlius pāstōrī bon____ pānem dat"}, {"t": "li", "n": 5, "text": "Ovēs ā pāstōre bon____ nōn abeunt."}, {"t": "li", "n": 6, "text": "Pāstōrēs bon____ ab ovibus su____ nōn abeunt."}, {"t": "li", "n": 7, "text": "Iūlius mult____ pāstōrēs habet."}, {"t": "li", "n": 8, "text": "Iūlius est dominus mult____ pāstōrum."}, {"t": "li", "n": 9, "text": "Iūlius pāstōribus su____ pānem dat."}, {"t": "li", "n": 10, "text": "Ovēs ā pāstōribus su____ nōn abeunt."}, {"t": "li", "n": 11, "text": "In campō sunt mult____ ovēs alb____ et ūn____ ovis nigr____ ."}, {"t": "li", "n": 12, "text": "Pāstor mult____ ovēs alb____ et ūn____ ovem nigr____ habet."}, {"t": "li", "n": 13, "text": "Pāstor est dominus ovium alb____ et ovis nigr____ ."}, {"t": "li", "n": 14, "text": "Pāstor ovibus alb____ et ovī nigr____ cibum dat."}, {"t": "li", "n": 15, "text": "Pāstor in campō est cum mult____ ovibus alb____ et ūn____ ove nigr____ ."}, {"t": "h", "text": "Exercitium 5"}, {"t": "li", "n": 1, "text": "In caelō nūllae nūb____ sunt."}, {"t": "li", "n": 2, "text": "Nūll____ nūb____ ante sōlem est."}, {"t": "li", "n": 3, "text": "Pāstor nūll____ nūbem in caelō videt."}, {"t": "li", "n": 4, "text": "In campō est coll____ parv____ cum magn____ arbor____ ."}, {"t": "li", "n": 5, "text": "Coll____ est mōns parv____ ."}, {"t": "li", "n": 6, "text": "Post campum sunt magn____ mont____ ."}, {"t": "li", "n": 7, "text": "In parv____ coll____ ūn____ arbor est."}, {"t": "li", "n": 8, "text": "In magnā silvā mult____ arbor____ sunt."}, {"t": "li", "n": 9, "text": "Pāstor ov____ su____ ad parv____ coll____ dūcit."}, {"t": "li", "n": 10, "text": "Pāstor fess____ cum ov____ su____ in umbrā magn____ arbor____ iacet."}, {"t": "li", "n": 11, "text": "Arbor pāstōr____ fess____ et ov____ fess____ umbram dat."}, {"t": "h", "text": "Lēctiō secunda (versūs 39–86)"}, {"t": "h", "text": "Exercitium 6"}, {"t": "p", "text": "Exemplum: Mēdus ā Iūliō abit = Mēdus Iūlium relinquit."}, {"t": "li", "n": 1, "text": "Servus improbus ā dominō suō abit = Servus improbus..."}, {"t": "li", "n": 2, "text": "Servī probī dominōs suōs nōn relinquunt = Servī probī..."}, {"t": "li", "n": 3, "text": "Mēdus et Lydia ā tabernā abeunt = Mēdus et Lydia..."}, {"t": "li", "n": 4, "text": "Iūlia ab Aemiliā et puerīs abit = Iūlia..."}, {"t": "li", "n": 5, "text": "Ovis nigra pāstōrem suum relinquit = Ovis nigra..."}, {"t": "li", "n": 6, "text": "Canis ā pāstōre nōn abit = Canis..."}, {"t": "li", "n": 7, "text": "Pāstor ovēs albās relinquit = Pāstor..."}, {"t": "li", "n": 8, "text": "Lupus ab ove et cane abit = Lupus..."}, {"t": "h", "text": "Exercitium 7"}, {"t": "li", "n": 1, "text": "____________ pāstor dormit, ovis nigra abit."}, {"t": "li", "n": 2, "text": "Canis ovem videt et ____________ : \"Baubau!\""}, {"t": "li", "n": 3, "text": "Pāstor ovēs ____________ et silvam petit."}, {"t": "li", "n": 4, "text": "Ovis nigra in magnā silvā ____________ ."}, {"t": "li", "n": 5, "text": "In terrā sunt ____________ lupī; lupus ____________ nōn procul abest."}, {"t": "li", "n": 6, "text": "Lupus in silvā cibum ____________ ."}, {"t": "li", "n": 7, "text": "Pāstor ovem quaerit, neque eam ____________ ."}, {"t": "li", "n": 8, "text": "Lupus ____________ : \"Uhuhū!\" Ovis ____________ : \"Bābā!\""}, {"t": "li", "n": 9, "text": "Ovis cōnsistit et exspectat ____________ lupus venit."}, {"t": "li", "n": 10, "text": "Oculī lupī in umbrā lūcent ____________ gemmae."}, {"t": "li", "n": 11, "text": "Lupus ____________ suōs albōs ostendit!"}, {"t": "li", "n": 12, "text": "Sed ecce canis ____________ et sine ____________ [< timēre] lupum petit!"}, {"t": "li", "n": 13, "text": "Pāstor clāmat; canis ____________ eius audit."}, {"t": "li", "n": 14, "text": "Pāstor parvam ovem in umerōs ____________ ."}, {"t": "h", "text": "Exercitium 8"}, {"t": "li", "n": 1, "text": "Quō abit ovis nigra? ..."}, {"t": "li", "n": 2, "text": "Dormitne canis? ..."}, {"t": "li", "n": 3, "text": "Quid agit pāstor? ..."}, {"t": "li", "n": 4, "text": "Ubi ovis nigra errat? ..."}, {"t": "li", "n": 5, "text": "Quid ovis videt in terrā? ..."}, {"t": "li", "n": 6, "text": "Quid lupus in silvā quaerit? ..."}, {"t": "li", "n": 7, "text": "Quid pāstor et canis quaerunt? ..."}, {"t": "li", "n": 8, "text": "Ululatne canis? ..."}, {"t": "li", "n": 9, "text": "Quid ovis ante sē in umbrā videt? ..."}, {"t": "li", "n": 10, "text": "Cūr lupus ovem relinquit? ..."}, {"t": "li", "n": 11, "text": "Quō pāstor ovem nigram portat? ..."}, {"t": "li", "n": 12, "text": "Cēterae ovēs quid agunt? ..."}, {"t": "h", "text